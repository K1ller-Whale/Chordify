<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- App Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chordify"
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-Powered Chord Detection"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Main Recording Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#F5FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center">

                    <!-- Wave Animation Container -->
                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginBottom="24dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieWave"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_autoPlay="false"
                            app:lottie_loop="true" />

                        <!-- Duration Overlay -->
                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:background="@drawable/duration_bg"/>

                    </FrameLayout>

                    <!-- Status Text -->
                    <TextView
                        android:id="@+id/tvInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap the button to start recording"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:layout_marginBottom="24dp"
                        android:gravity="center"/>

                    <!-- Record Button Container -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!-- Large Circular Record Button -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabRecord"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:backgroundTint="@color/primary"
                            app:tint="@color/white"
                            app:elevation="8dp"
                            app:pressedTranslationZ="12dp"
                            app:fabSize="normal"
                            android:src="@android:drawable/ic_btn_speak_now"
                            android:contentDescription="Start Recording"/>

                        <!-- Stop Button (overlaps when recording) -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabStop"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:backgroundTint="@color/error"
                            app:tint="@color/white"
                            app:elevation="8dp"
                            app:pressedTranslationZ="12dp"
                            app:fabSize="normal"
                            android:src="@android:drawable/ic_media_pause"
                            android:contentDescription="Stop Recording"
                            android:visibility="gone"/>

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F5FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@+id/cardRecording"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DETECTED CHORD"
                        android:textSize="11sp"
                        android:textColor="#80000000"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.15"/>

                    <!-- Chord Display -->
                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="96sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"/>

                    <!-- Confidence Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/primary_container"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confidence: --"
                            android:textColor="@color/on_primary_container"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:padding="12dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"/>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/primary"/>

                    <!-- Error Message -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:gravity="center"
                        android:maxWidth="300dp"/>

                    <!-- Time-Stamped Analysis Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimeStamped"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analyze Time Segments"
                        android:textColor="@color/primary"
                        app:icon="@android:drawable/ic_menu_sort_by_size"
                        app:iconTint="@color/primary"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        android:minHeight="48dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Time-Stamped Results Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTimeStampedResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#F5FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@+id/cardResult"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME-STAMPED RESULTS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#80000000"
                        android:textAllCaps="true"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewTimeStamped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
