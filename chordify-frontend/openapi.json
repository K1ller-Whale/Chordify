      "title": "Filename"
     },
     "created_at": {
      "type": "string",
      "title": "Created At"
     },
     "error": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AnalysisError"
       },
       {
        "type": "null"
       }
      ]
     },
     "links": {
      "$ref": "#/components/schemas/Links"
     }
    },
    "type": "object",
    "required": [
     "id",
     "status",
     "created_at",
     "links"
    ],
    "title": "AnalysisStatus"
   },
