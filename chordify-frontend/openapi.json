      "schema": {
       "type": "string",
       "title": "Analysis Id"
      }
     },
     {
      "name": "last-event-id",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
