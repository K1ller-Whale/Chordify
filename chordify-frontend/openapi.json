    "type": "object",
    "required": [
     "analysis_id",
     "source",
     "models",
     "tempo",
     "key",
     "beats",
     "downbeats",
     "bars",
     "chords",
     "summary"
    ],
    "title": "AnalysisResult"
   },
   "AnalysisStatus": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "status": {
      "type": "string",
