   },
   "post": {
    "tags": [
     "analyses"
    ],
    "summary": "Create Analysis",
    "description": "Upload audio (multipart ``file`` + optional ``options`` JSON) and start an analysis.",
    "operationId": "create_analysis_api_v2_analyses_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_create_analysis_api_v2_analyses_post"
       }
